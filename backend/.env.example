# SEHATI Backend Environment Variables
# Instructions:
# 1. Copy this file to .env
# 2. Replace all placeholder values (inside < > or [ ]) with your actual credentials.
# 3. NEVER commit the actual .env file to GitHub!

# Server Configuration
# ------------------------
PORT=5001

# Supabase Project Credentials
# ------------------------
SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# Supabase PostgreSQL Database
# IMPORTANT: You can use direct connection or session pooler URL.
# Get these from: Supabase Dashboard -> Settings -> Database -> Connection string

# A) DIRECT CONNECTION (for Prisma Migrations & Runtime)
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DIRECT_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres"

# B) RUNTIME CONNECTION (for Prisma Client)
# Can use the same direct connection or pooler URL
DATABASE_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres"

# Redis
# ------------------------
# Dipakai untuk: cache-aside GET /api/v1/screening/share/:shareHash,
# cache lookup HealthKnowledgeBase, dan store rate-limiter (lihat FDD §7).
# Untuk dev lokal, jalankan Redis lewat Docker: docker run -p 6379:6379 redis
REDIS_URL="redis://localhost:6379"

# Static API Key that protects POST /api/v1/ingest/upload
# Must be sent in the "X-API-KEY" request header.
GATEWAY_API_KEY="change_me_to_a_strong_secret"

# ML Service (FastAPI)
# URL for the FastAPI ML microservice (Z-Score & Risk Prediction)
# If running locally without Docker: http://localhost:8000/api/v1/predict
# If running with Docker Compose: http://ml-service:8000/api/v1/predict
ML_SERVICE_URL="http://localhost:8000/api/v1/predict"

# Frontend CORS (Optional)
# Allow specific frontend domains to access this API.
CORS_ORIGIN="http://localhost:3000, http://localhost:5173"

# Google Gemini AI API Configuration
# Get your API Key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.6-flash"
