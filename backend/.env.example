# SEHATI Backend Environment Variables
# Instructions:
# 1. Copy this file to .env
# 2. Replace all placeholder values (inside < > or [ ]) with your actual credentials.
# 3. NEVER commit the actual .env file to GitHub!

# Server Configuration
# ------------------------
PORT=5000

# Supabase PostgreSQL Database
# IMPORTANT: You need TWO URLs for Supabase.
# Get these from: Supabase Dashboard -> Settings -> Database -> Connection string

# A) SESSION POOLER (for Prisma Client / App Runtime)
# Use this for normal app operations. Usually uses port 6543.
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[YOUR_REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# B) DIRECT CONNECTION (for Prisma Migrations only)
# Use this for running `npx prisma migrate dev`. Usually uses port 5432.
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[YOUR_REGION].pooler.supabase.com:5432/postgres"

# ML Service (FastAPI)
# URL for the FastAPI ML microservice (Z-Score & Risk Prediction)
# If running locally without Docker: http://localhost:8000/api/v1/predict
# If running with Docker Compose: http://ml-service:8000/api/v1/predict
ML_SERVICE_URL="http://localhost:8000/api/v1/predict"

# Frontend CORS (Optional)
# Allow specific frontend domains to access this API.
CORS_ORIGIN="http://localhost:3000"