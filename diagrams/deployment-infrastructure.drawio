        <mxCell id="note2" value="Catatan: tidak ditemukan berkas .domcloud.yml ter-commit di repositori. Topologi ini merepresentasikan konfigurasi environment variable (ML_SERVICE_URL, DATABASE_URL, DIRECT_URL) yang benar-benar dipakai aplikasi saat runtime." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="500" height="90" as="geometry"/></mxCell>
