# ==============================================================================
# SEHATI Frontend Environment Configuration Example
# ==============================================================================
# Salin file ini menjadi `.env` atau `.env.local` pada environment lokal Anda:
#   cp .env.example .env
# ==============================================================================

# [Opsional di Dev / Wajib di Prod]
# Base URL Backend API Gateway (Express.js)
# Digunakan oleh Axios HTTP Client (`src/lib/api.ts`) untuk endpoint skrining & health check.
# Fallback default di kode jika tidak diset: http://localhost:5001
VITE_API_URL=http://localhost:5001

# [Opsional] Supabase Configuration
# Digunakan jika frontend mengakses layanan Supabase secara langsung.
VITE_SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
